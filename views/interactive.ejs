<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
  <title>Image — click to reveal</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html, body { height: 100%; }
    body {
      background: #000;
      color: #eee;
      font-family: ui-monospace, 'IBM Plex Mono', SFMono-Regular, Menlo, monospace;
      overflow: hidden;
    }

    .stage {
      position: fixed;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: zoom-in;
    }

    /* The heavily pixelated teaser. CSS blur makes it read as "locked". */
    #preview {
      max-width: 100%;
      max-height: 100%;
      object-fit: contain;
      filter: blur(8px);
      transform: scale(1.05);
      transition: filter 0.5s ease, transform 0.5s ease, opacity 0.4s ease;
      user-select: none;
      -webkit-user-drag: none;
    }

    /* Subtle vignette */
    .scrim {
      position: fixed;
      inset: 0;
      background: radial-gradient(ellipse at center, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.6) 100%);
      pointer-events: none;
      transition: opacity 0.4s ease;
    }

    .cta {
      position: fixed;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
      text-align: center;
      pointer-events: none;
      transition: opacity 0.35s ease;
      padding: 1rem;
    }

    .badge {
      width: 80px;
      height: 80px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      background: rgba(0, 255, 0, 0.1);
      border: 2px solid #0f0;
      box-shadow: 0 0 0 0 rgba(0, 255, 0, 0.5);
      animation: pulse 2s infinite;
    }
    .badge svg { width: 40px; height: 40px; color: #0f0; }

    @keyframes pulse {
      0%   { box-shadow: 0 0 0 0 rgba(0, 255, 0, 0.45); }
      70%  { box-shadow: 0 0 0 24px rgba(0, 255, 0, 0); }
      100% { box-shadow: 0 0 0 0 rgba(0, 255, 0, 0); }
    }

    .cta-title {
      font-size: clamp(1.1rem, 4vw, 1.6rem);
      font-weight: 700;
      color: #0f0;
      letter-spacing: -0.02em;
    }
    .cta-sub {
      font-size: clamp(0.85rem, 2.8vw, 1rem);
      color: #888;
    }

    .stage.revealed { cursor: default; }
    .stage.revealed #preview { filter: none; transform: scale(1); }
    .stage.revealed .scrim,
    .stage.revealed .cta { opacity: 0; }

    .spinner {
      display: none;
      width: 40px; height: 40px;
      border: 3px solid rgba(0,255,0,0.2);
      border-top-color: #0f0;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .loading .badge, .loading .cta-title, .loading .cta-sub { display: none; }
    .loading .spinner { display: block; }
  </style>
</head>
<body>
  <div class="stage" id="stage" title="Click to reveal full resolution">
    <img id="preview" src="/<%= code %>?img=interactive" alt="preview" />
    <div class="scrim"></div>
    <div class="cta" id="cta">
      <div class="badge">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
        </svg>
      </div>
      <div class="spinner"></div>
      <div class="cta-title">Click to reveal</div>
      <div class="cta-sub">tap the image for full resolution</div>
    </div>
  </div>

  <script>
    (function () {
      const stage = document.getElementById('stage');
      const img   = document.getElementById('preview');
      const cta   = document.getElementById('cta');
      let done = false;

      function reveal() {
        if (done) return;
        done = true;
        cta.classList.add('loading');
        const full = new Image();
        full.onload = function () {
          img.src = full.src;
          stage.classList.add('revealed');
        };
        full.onerror = function () {
          stage.classList.add('revealed');
        };
        full.src = '/<%= code %>?img=full';
      }

      stage.addEventListener('click', reveal);
    })();
  </script>
</body>
</html>
